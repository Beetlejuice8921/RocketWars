/* Шрифт — пиксельный Press Start 2P (моноширинный, широкий): размеры подобраны под него. */
/* Rocket Wars — интерфейс (UI Toolkit). Палитра: светлое небо, белый «пиксельный» текст с тенью, команды красные/зелёные. */

.root {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 14px;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.shadow {
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.55);
}

.hidden {
    display: none;
}

/* ---------- панели и кнопки ---------- */

.panel {
    background-color: rgba(28, 32, 40, 0.88);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    padding: 24px 28px;
}

.title {
    font-size: 35px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.section {
    font-size: 11px;
    color: rgb(170, 182, 200);
    margin-top: 18px;
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.row {
    flex-direction: row;
    align-items: center;
}

.row-center {
    justify-content: center;
}

.grow {
    flex-grow: 1;
}

.btn {
    height: 44px;
    margin: 4px;
    padding: 0 18px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(58, 66, 82);
    border-width: 0;
    border-radius: 6px;
}

.btn:hover {
    background-color: rgb(78, 90, 110);
}

.btn:active {
    background-color: rgb(40, 46, 58);
}

.btn:disabled {
    opacity: 0.45;
}

.btn-primary {
    background-color: rgb(46, 150, 70);
}

.btn-primary:hover {
    background-color: rgb(60, 175, 88);
}

.btn-danger {
    background-color: rgb(170, 48, 44);
}

.btn-danger:hover {
    background-color: rgb(196, 62, 56);
}

.btn-small {
    height: 34px;
    font-size: 10px;
    padding: 0 12px;
}

.field {
    font-size: 12px;
    margin: 4px;
}

.field > .unity-base-text-field__input {
    background-color: rgb(20, 24, 30);
    color: rgb(255, 255, 255);
    border-color: rgba(255, 255, 255, 0.2);
    min-height: 36px;
    -unity-text-align: middle-left;
}

.label-dim {
    color: rgb(170, 182, 200);
    font-size: 11px;
}

.status {
    color: rgb(255, 196, 120);
    font-size: 11px;
    white-space: normal;
    margin-top: 10px;
}

.list {
    min-height: 60px;
    max-height: 312px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    margin: 4px;
}

/* полоса прокрутки списка: тонкая, без стрелок, в цвет панели */
.list .unity-scroller--vertical {
    width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.list .unity-scroller__low-button,
.list .unity-scroller__high-button {
    display: none;
}

.list .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
    padding: 0;
}

.list .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 0;
    border-radius: 0;
}

.list .unity-scroller .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.28);
    border-width: 0;
    border-radius: 0;
}

.list .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.45);
}

/* код комнаты: клетка на каждый символ, ввод — невидимым полем поверх */
.code-box {
    align-items: center;
    margin: 0 12px;
}

.code-row {
    margin-top: 6px;
}

.code-side {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.code-side-left {
    justify-content: flex-end;
}

.code-cells {
    flex-direction: row;
}

.code-cell {
    width: 44px;
    height: 44px;
    margin: 0 4px;
    background-color: rgb(16, 18, 22);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
    font-size: 20px;
    -unity-text-align: middle-center;
    color: rgb(240, 240, 240);
}

.code-cell--active {
    border-color: rgb(80, 190, 100);
}

.code-cell--error {
    border-color: rgb(220, 70, 60);
    color: rgb(255, 110, 100);
}

.code-input {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    opacity: 0;
}

.list-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.list-item > Label {
    flex-grow: 1;
    font-size: 11px;
}

/* ---------- главное меню ---------- */

.menu-screen {
    align-items: flex-start;
    justify-content: center;
    padding-left: 64px;
    padding-bottom: 96px; /* колонка чуть выше центра экрана */
    background-color: rgba(10, 14, 20, 0.35);
}

/* панель и кнопки под ней — одной колонкой у левого края */
.menu-column {
    width: 760px;
}

.menu-panel {
    background-color: rgba(28, 32, 40, 0.6);
}

/* название игры — по центру вверху экрана */
.menu-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    font-size: 64px;
    -unity-text-align: middle-center;
    text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
}

/* под панелью меню, друг под другом: «Опции», «Поддержка», «Выйти из игры» */
.menu-side {
    width: 340px;
    margin-top: 6px;
}

.menu-side-btn {
    height: 56px;
    font-size: 14px;
    margin: 6px 0 0 0;
}

/* столбик кнопок слева, «Как играть?» — справа, вровень с первой кнопкой */
.menu-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.menu-howto-btn {
    width: 240px;
    margin-top: 12px;
}

/* правый столбик под панелью: «Как играть?» и под ней — подписка на бота */
.menu-right {
    align-items: flex-end;
}

/* подписка на бота Telegram: пиксельная кнопка с колокольчиком, подписан — зелёная плашка с галочкой */
.bot-btn {
    flex-direction: row;
    align-items: center;
    width: 360px;
    min-height: 64px;
    margin: 12px 0 0 0;
    padding: 8px 14px 8px 12px;
    background-color: rgb(34, 139, 206);
    border-width: 0 0 4px 0;
    border-color: rgb(18, 84, 130);
    border-radius: 0;
    color: rgb(255, 255, 255);
}

.bot-btn:hover {
    background-color: rgb(52, 160, 228);
}

.bot-btn:active {
    border-bottom-width: 1px;
    margin-top: 15px;
}

.bot-btn:disabled {
    opacity: 0.6;
}

.bot-btn--on {
    background-color: rgb(30, 70, 44);
    border-color: rgb(16, 40, 24);
}

.bot-btn--on:hover {
    background-color: rgb(38, 88, 56);
}

.bot-btn--confirm {
    background-color: rgb(150, 44, 40);
    border-color: rgb(84, 22, 20);
}

.bot-btn--confirm:hover {
    background-color: rgb(176, 56, 50);
}

.bot-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    margin-right: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.bot-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.bot-title {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.bot-note {
    font-size: 8px;
    margin: 6px 0 0 0;
    padding: 0;
    white-space: normal;
    color: rgba(255, 255, 255, 0.75);
}

.bot-btn--on .bot-note {
    color: rgb(140, 230, 150);
}

.bot-note--error {
    color: rgb(255, 196, 120);
}

/* ---------- как играть ---------- */

.howto-panel {
    width: 900px;
    max-height: 94%;
    background-color: rgb(28, 32, 40);
}

.howto-list {
    max-height: 560px;
    padding: 4px 14px 14px 14px;
}

/* текст окна — на 20% крупнее обычного: заголовок 35 → 42, кнопка 12 → 14.4 */
.howto-panel .title {
    font-size: 42px;
}

.howto-panel .btn {
    font-size: 14.4px;
}

.howto-heading {
    font-size: 15.6px;
    color: rgb(120, 210, 140);
    margin-top: 14px;
}

.howto-text {
    font-size: 14.4px;
    white-space: normal;
    color: rgb(225, 230, 238);
}

.touch-mode .howto-panel { width: 94%; }
.touch-mode .howto-list { max-height: 300px; }

/* ---------- опции ---------- */

.options-panel {
    width: 820px;
    max-height: 94%;
    background-color: rgb(28, 32, 40);
}

.options-scroll {
    flex-shrink: 1;
    margin-bottom: 8px;
}

.options-value {
    width: 90px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.bind-row {
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.bind-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    white-space: normal;
}

.bind-key {
    width: 260px;
}

.bind-listening {
    background-color: rgb(196, 130, 40);
}

.lang-panel {
    width: 820px;
    background-color: rgb(28, 32, 40);
    align-items: center;
}

.lang-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 12px;
}

.lang-option {
    width: 240px;
}

/* ---------- HUD ---------- */

.hud {
    padding: 0;
}

/* верхняя панель матча: игроки красных | счёт и раунд | игроки зелёных */
.teambar {
    position: absolute;
    top: 8px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.teambar-side {
    flex-direction: row;
    width: 40%;
}

/* у левой команды карточки прижаты к центру */
.teambar-left {
    justify-content: flex-end;
}

.teambar-right {
    justify-content: flex-start;
}

.teambar-center {
    align-items: center;
    margin: 0 8px;
}

.teambar-scores {
    flex-direction: row;
}

.teambar-score {
    font-size: 36px;
    width: 89px;
    height: 67px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0.6);
}

.teambar-score0 {
    background-color: rgba(190, 30, 28, 0.85);
}

.teambar-score1 {
    background-color: rgba(28, 160, 64, 0.85);
    margin-left: -5px;
}

.teambar-round {
    font-size: 13px;
    margin-top: 6px;
    padding: 5px 8px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.5);
}

.teambar-card {
    width: 104px;
    align-items: center;
    margin: 0 4px;
}

.teambar-head {
    width: 67px;
    height: 67px;
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0.6);
}

.teambar-head-img {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* число фрагов поверх головы */
.teambar-frags {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 25px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.teambar-name {
    font-size: 12px;
    margin-top: 5px;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

/* лежащий: голова уже чёрно-белая, рамка и ник серые */
.teambar-downed .teambar-head {
    border-color: rgba(60, 60, 60, 0.8);
    background-color: rgba(0, 0, 0, 0.6);
}

.teambar-downed .teambar-frags {
    color: rgb(170, 170, 170);
}

.teambar-downed .teambar-name {
    color: rgb(150, 150, 150);
}

.teambar-me .teambar-head {
    border-color: rgb(255, 220, 80);
}

.team0 {
    color: rgb(225, 40, 36);
}

.team1 {
    color: rgb(40, 210, 80);
}

/* лента событий матча (как в Counter-Strike) */
.feed {
    position: absolute;
    right: 20px;
    top: 230px;
    align-items: flex-end;
}

.feed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    padding: 3px 10px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.feed-me {
    border-color: rgb(230, 60, 50);
    background-color: rgba(40, 0, 0, 0.6);
}

.feed-name {
    font-size: 12px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.7);
}

.feed-icon {
    width: 36px;
    height: 22px;
    margin: 0 8px;
}

/* маркер попадания из пистолета */
/* маркер попадания: точка привязки в центре экрана, штрихи 6×18 по диагоналям (позиции и поворот задаёт код) */
.hitmarker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.hm-bar {
    position: absolute;
    width: 6px;
    height: 18px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

/* вид в бинокль */
.bino-line-h {
    position: absolute;
    left: 38%;
    right: 38%;
    top: 50%;
    height: 2px;
    background-color: rgba(20, 20, 20, 0.75);
}

.bino-line-v {
    position: absolute;
    top: 42%;
    bottom: 42%;
    left: 50%;
    width: 2px;
    background-color: rgba(20, 20, 20, 0.75);
}

.bino-tick {
    position: absolute;
    top: 49%;
    width: 2px;
    height: 2%;
    background-color: rgba(20, 20, 20, 0.75);
}

.bino-zoom {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 120px;
    margin-left: -60px;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
}

.bino-distance {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 320px;
    margin-left: -160px;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 214, 90);
}

/* оптика снайперки */
.scope-line-h {
    position: absolute;
    left: 20%;
    right: 20%;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background-color: rgba(10, 10, 10, 0.9);
}

.scope-line-v {
    position: absolute;
    top: 6%;
    bottom: 6%;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background-color: rgba(10, 10, 10, 0.9);
}

.scope-post-l {
    position: absolute;
    left: 20%;
    width: 18%;
    top: 50%;
    height: 8px;
    margin-top: -4px;
    background-color: rgb(10, 10, 10);
}

.scope-post-r {
    position: absolute;
    right: 20%;
    width: 18%;
    top: 50%;
    height: 8px;
    margin-top: -4px;
    background-color: rgb(10, 10, 10);
}

.scope-post-b {
    position: absolute;
    left: 50%;
    width: 8px;
    margin-left: -4px;
    top: 72%;
    bottom: 0;
    background-color: rgb(10, 10, 10);
}

.scope-dot {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 4px;
    margin-left: -4px;
    margin-top: -2px;
    background-color: rgb(10, 10, 10);
}

.scope-center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    margin-top: -2px;
    background-color: rgb(255, 50, 40);
}

.scope-zoom {
    position: absolute;
    left: 53%;
    top: 30%;
    -unity-text-align: middle-left;
    font-size: 16px;
    -unity-font-style: bold;
}

.scope-distance {
    position: absolute;
    left: 53%;
    top: 34%;
    -unity-text-align: middle-left;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 214, 90);
}

/* край каски в приседе: выезжает сверху экрана */
.helmet-brim {
    position: absolute;
    left: -2%;
    right: -2%;
    top: 0;
    height: 21%;
}

/* столбик дуги (left/width/height — из кода); полоса и кромка сдвигаются вместе с его низом */
.helmet-col {
    position: absolute;
    top: 0;
    background-color: rgb(74, 84, 48);
}

/* цвета непрозрачные: соседние столбики могут на пиксель перекрываться */
.helmet-band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    height: 12px;
    background-color: rgb(61, 69, 39);
}

.helmet-lip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18px;
    background-color: rgb(46, 52, 30);
}

.protection {
    top: 11%;
    font-size: 20px;
    color: rgb(170, 255, 150);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8);
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
}

.crosshair-h,
.crosshair-v {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.9);
}

.crosshair-h {
    left: 0;
    right: 0;
    top: 8px;
    height: 2px;
}

.crosshair-v {
    top: 0;
    bottom: 0;
    left: 8px;
    width: 2px;
}

.hp {
    position: absolute;
    bottom: 34px;
    left: 50%;
    width: 560px;
    margin-left: -280px;
    height: 62px;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.35);
}

.hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(235, 20, 20);
}

.hp-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 25px;
    -unity-font-style: bold;
}

/* броня из бронежилета: синяя полоса над полосой здоровья */
.armor {
    position: absolute;
    bottom: 104px;
    left: 50%;
    width: 560px;
    margin-left: -280px;
    height: 26px;
    border-width: 3px;
    border-color: rgb(200, 220, 255);
    background-color: rgba(0, 0, 0, 0.35);
}

.armor-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(40, 110, 235);
}

.armor-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}

/* патроны пулемёта справа внизу */
.ammo {
    position: absolute;
    right: 40px;
    bottom: 40px;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(255, 225, 120);
}

/* что выпало из ящика */
.loot {
    top: 63%;
    font-size: 19px;
    color: rgb(255, 215, 90);
}

/* маяк: вражеские шахты видны на пульте */
.beacon {
    top: 12%;
    font-size: 15px;
    color: rgb(255, 120, 90);
}

.center-text {
    position: absolute;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.banner {
    top: 26%;
    font-size: 44px;
}

.subbanner {
    top: 35%;
    font-size: 17px;
}

/* разминка: «Enter — начать матч» крупно (мигание — в HudView.UpdateMatch) */
.subbanner-lobby {
    top: 36%;
    font-size: 34px;
}

.countdown {
    bottom: 13%;
    font-size: 93px;
}

.downed {
    top: 30%;
    font-size: 26px;
}

.falling {
    top: 40%;
    font-size: 25px;
}

.prompt {
    top: 54%;
    font-size: 14px;
}

.progress {
    position: absolute;
    top: 59%;
    left: 50%;
    width: 300px;
    margin-left: -150px;
    height: 14px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 4px;
}

.progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(80, 200, 255);
    border-radius: 4px;
}

/* ник над игроком: мелко, без плашки, по центру над головой (точка привязки — низ надписи) */
.nametag {
    position: absolute;
    width: 300px;
    height: 16px;
    margin-left: -150px;
    margin-top: -16px;
    -unity-text-align: lower-center;
    font-size: 12px;
}

/* лежащий союзник: плашка HELP!, расстояние и вылетающие вверх копии надписи (точка привязки — 0×0) */
.help {
    position: absolute;
    width: 0;
    height: 0;
}

.help-dist {
    position: absolute;
    left: -105px;
    top: 42px;
    width: 210px;
    -unity-text-align: upper-center;
    font-size: 14px;
    -unity-font-style: bold;
}

.help-rise {
    position: absolute;
    left: -140px;
    top: -84px;
    width: 280px;
    height: 56px;
    -unity-text-align: middle-center;
    font-size: 25px;
    -unity-font-style: bold;
    color: rgb(255, 80, 60);
}

.info {
    position: absolute;
    left: 24px;
    top: 46px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.95);
}

.room-code {
    position: absolute;
    left: 24px;
    top: 20px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 150, 30);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.minimap {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 300px;
    height: 190px;
    border-width: 4px;
    border-color: rgb(200, 200, 200);
    background-color: rgb(118, 118, 122);
}

.minimap-me {
    position: absolute;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    background-color: rgb(40, 110, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

/* ---------- лобби / пауза / результаты ---------- */

.overlay {
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 14, 20, 0.45);
}

.lobby-panel {
    position: absolute;
    top: 150px;
    left: 50%;
    width: 640px;
    margin-left: -320px;
    align-items: center;
}

.results-panel {
    width: 1840px;
    max-height: 90%;
}

/* в конце матча таблица прижата к верху, под ней — пьедестал */
.results-final {
    justify-content: flex-start;
    padding-top: 10px;
    background-color: rgba(10, 14, 20, 0.6);
}

.results-final .results-panel {
    max-height: 58%;
}

.podium {
    width: 1840px;
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin: 8px 0 10px 0;
    padding: 6px 0;
    background-color: rgba(28, 32, 40, 0.88);
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.15);
}

.podium-slot {
    width: 440px;
    align-items: center;
    margin: 0 16px;
}

.podium-slot-1 {
    width: 600px;
}

.podium-slot-2 {
    margin-top: 40px;
}

.podium-slot-3 {
    margin-top: 64px;
}

/* место под модельку в раскладке; сама моделька (текстура 48x64) крупнее и свисает за пьедестал */
.podium-figure-space {
    height: 150px;
}

.podium-figure-space-1 {
    height: 200px;
}

.podium-figure {
    position: absolute;
    left: 50%;
    width: 240px;
    height: 320px;
    margin-left: -120px;
}

.podium-figure-1 {
    width: 336px;
    height: 448px;
    margin-left: -168px;
}

.podium-place {
    font-size: 14px;
    margin-bottom: 4px;
}

.podium-color-1 {
    color: rgb(255, 210, 60);
}

.podium-color-2 {
    color: rgb(205, 215, 228);
}

.podium-color-3 {
    color: rgb(222, 140, 80);
}

.podium-name {
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}

.podium-slot-1 .podium-name {
    font-size: 26px;
}

.podium-stats {
    font-size: 10px;
    color: rgb(190, 200, 214);
    margin-bottom: 2px;
}

.podium-block {
    align-items: center;
    justify-content: center;
    width: 100%;
    border-width: 4px;
    border-radius: 0;
}

.podium-block-1 {
    height: 64px;
    background-color: rgb(232, 180, 40);
    border-color: rgb(150, 110, 20);
}

.podium-block-2 {
    height: 44px;
    background-color: rgb(170, 180, 194);
    border-color: rgb(100, 108, 120);
}

.podium-block-3 {
    height: 32px;
    background-color: rgb(196, 112, 56);
    border-color: rgb(120, 64, 28);
}

.podium-number {
    position: absolute;
    font-size: 26px;
    -unity-text-align: middle-center;
}

.podium-block-3 .podium-number {
    font-size: 20px;
}

.podium-achievements {
    margin-top: 6px;
    align-items: flex-start;
}

.podium-achievement {
    flex-direction: row;
    align-items: center;
    margin: 1px 0;
}

.podium-achievement .badge {
    border-radius: 0;
    margin-right: 10px;
}

.podium-achievement-title {
    font-size: 14px;
}

.results-columns {
    flex-direction: row;
}

.results-team {
    flex-grow: 1;
    flex-basis: 0;
    margin: 6px;
}

/* команда-победитель: рамка (цвет — из кода, по команде) и плашка над названием */
.results-team--winner {
    border-width: 3px;
    border-radius: 6px;
    padding: 4px;
}

.results-winner-tag {
    align-self: center;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding: 2px 14px;
    border-radius: 4px;
    margin-bottom: 4px;
}

/* надпись о победителе перед таблицей итогов */
.results-intro {
    top: 38%;
    font-size: 96px;
}

.results-team-title {
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.results-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.results-header {
    color: rgb(170, 182, 200);
}

.results-header > Label {
    font-size: 10px;
}

.results-me {
    background-color: rgba(80, 140, 255, 0.18);
}

.col-name {
    flex-grow: 1;
    font-size: 12px;
    overflow: hidden;
}

.col-num {
    width: 84px;
    -unity-text-align: middle-center;
    font-size: 12px;
}

.col-badges {
    width: 176px;
    flex-direction: row;
}

.badge {
    width: 27px;
    height: 27px;
    margin: 1px;
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(20, 20, 20);
}

.tooltip {
    position: absolute;
    max-width: 340px;
    padding: 8px 12px;
    background-color: rgb(20, 24, 30);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 6px;
    font-size: 10px;
    white-space: normal;
}

.tooltip-title {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

/* ---------- сенсорное управление (UI/TouchControls): телефон, база 1920×1080 с масштабом ×1.4 ---------- */
.touch-btn {
    position: absolute;
    align-items: center;
    justify-content: center;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.75);
    background-color: rgba(0, 0, 0, 0.35);
}

.touch-pressed {
    background-color: rgba(232, 197, 71, 0.6);
    border-color: rgb(255, 255, 255);
}

.touch-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.7);
}

/* раскладка как в Modern Strike Online / World War Heroes: «Огонь» под большим пальцем,
   прыжок над ним, прицел слева, присед снизу; второй «Огонь» над джойстиком; «Действие» — только по делу */
.touch-fire { right: 50px; bottom: 90px; width: 200px; height: 200px; }
.touch-fire .touch-label { font-size: 20px; }
.touch-fire-left { left: 60px; bottom: 450px; width: 130px; height: 120px; }
.touch-jump { right: 40px; bottom: 310px; width: 140px; height: 110px; }
.touch-aim { right: 270px; bottom: 160px; width: 140px; height: 130px; }
.touch-crouch { right: 240px; bottom: 26px; width: 160px; height: 100px; }
.touch-use { right: 220px; bottom: 320px; width: 200px; height: 110px; border-color: rgb(255, 200, 60); background-color: rgba(60, 40, 0, 0.45); }
.touch-use .touch-label { color: rgb(255, 215, 90); }
.touch-trick { right: 440px; bottom: 320px; width: 140px; height: 110px; }

/* «замок» бега над джойстиком: довести палец — бег фиксируется */
.touch-sprint-lock {
    position: absolute;
    width: 120px;
    height: 56px;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(0, 0, 0, 0.3);
}
.touch-sprint-lock .touch-label { font-size: 12px; }

/* нажатая — поверх цветов отдельных кнопок («Действие», «замок» бега) */
.touch-btn.touch-pressed, .touch-sprint-lock.touch-pressed { background-color: rgba(232, 197, 71, 0.6); border-color: rgb(255, 255, 255); }
.touch-pause { left: 24px; top: 24px; width: 90px; height: 70px; }
.touch-score { left: 130px; top: 24px; width: 120px; height: 70px; }

/* джойстик: в покое — внизу слева бледной подсказкой, под пальцем — ярче */
.touch-stick {
    position: absolute;
    left: 110px;
    bottom: 90px;
    width: 220px;
    height: 220px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.3);
    border-radius: 110px;
    background-color: rgba(0, 0, 0, 0.15);
    align-items: center;
    justify-content: center;
}

.touch-stick-active {
    border-color: rgba(255, 255, 255, 0.7);
    background-color: rgba(0, 0, 0, 0.3);
}

.touch-knob {
    width: 96px;
    height: 96px;
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    border-radius: 48px;
    background-color: rgba(232, 197, 71, 0.55);
}
.touch-start { left: 50%; top: 440px; width: 260px; height: 90px; margin-left: -130px; background-color: rgba(46, 150, 70, 0.75); }
.touch-start .touch-label { font-size: 22px; }

/* телефон: код комнаты и сводка команды — под кнопками «II» и «СЧЁТ» */
.touch-mode .room-code { top: 110px; font-size: 14px; }
.touch-mode .info { top: 132px; font-size: 14px; } /* панель на телефоне и так ×1.4 — крупнее упёрлись бы в мини-карту */

/* телефон: итоги во всю ширину (база 1920 там ~1500), пьедестал компактнее — иначе не влезает по высоте */
.touch-mode .results-panel,
.touch-mode .podium { width: 96%; }
.touch-mode .podium-slot { scale: 0.56 0.56; transform-origin: 50% 0; margin: 0 -90px; }
.touch-mode .podium { margin: 4px 0 4px 0; padding: 2px 0; }


/* ---------- рейтинг (LeaderboardView, строка в итогах матча) ---------- */

.results-rating {
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgb(170, 182, 200);
    white-space: normal;
    margin-bottom: 10px;
}

.results-rating--good {
    color: rgb(255, 214, 90);
}

/* окно скинов: солдат по центру, ячейки скинов снизу */
.skin-panel {
    width: 760px;
    max-height: 94%;
    align-items: center;
    background-color: rgb(28, 32, 40);
}

/* текстура солдата 64×96 — ×4 крупными пикселями; на низком экране сжимается, сохраняя пропорции */
.skin-figure {
    width: 256px;
    height: 384px;
    min-height: 120px;
    flex-shrink: 1;
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 12px;
}

.skin-list {
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.skin-cell {
    width: 104px;
    height: 104px;
    padding: 0 4px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.skin-cell-locked {
    background-color: rgb(44, 50, 62);
    color: rgb(120, 130, 146);
    border-width: 2px;
    border-color: rgb(70, 78, 94);
}

/* кнопка «Скин» справа от поля имени */
.menu-skin-btn {
    min-width: 120px;
}

.leaderboard-panel {
    width: 980px;
    max-height: 94%;
    background-color: rgb(28, 32, 40);
}

.leaderboard-tab {
    min-width: 220px;
}

.leaderboard-reset {
    -unity-text-align: middle-center;
    margin: 6px 0 10px 0;
}

.leaderboard-list {
    max-height: 520px;
    min-height: 120px;
}

.leaderboard-row {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.leaderboard-header {
    height: 30px;
    margin: 0 4px;
    border-bottom-width: 0;
}

.leaderboard-header > Label {
    font-size: 10px;
    color: rgb(170, 182, 200);
}

.lb-rank {
    width: 80px;
    font-size: 12px;
}

.lb-name {
    flex-grow: 1;
    font-size: 12px;
    overflow: hidden;
}

.lb-num {
    width: 140px;
    font-size: 12px;
    -unity-text-align: middle-right;
}

.leaderboard-me {
    font-size: 12px;
    color: rgb(255, 214, 90);
    white-space: normal;
    margin: 10px 4px 0 4px;
}

.leaderboard-hint {
    white-space: normal;
    margin: 10px 4px;
}

.touch-mode .leaderboard-panel { width: 94%; }
.touch-mode .leaderboard-list { max-height: 300px; }
.touch-mode .lb-num { width: 100px; }
/* ---------- стрим-комната ---------- */

/* QR-код у стримера: слева, под кодом комнаты; между матчами крупно, в раунде — компактно */
.stream-qr {
    position: absolute;
    left: 24px;
    top: 150px;
    padding: 10px;
    align-items: center;
    background-color: rgba(28, 32, 40, 0.9);
    border-width: 3px;
    border-color: rgb(255, 150, 30);
}

.stream-qr-title {
    font-size: 14px;
    color: rgb(255, 150, 30);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.stream-qr-image {
    width: 196px;
    height: 196px;
    background-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
}

.stream-qr-code {
    font-size: 16px;
    margin-top: 8px;
    -unity-text-align: middle-center;
}

.stream-qr-queue {
    font-size: 11px;
    color: rgb(170, 182, 200);
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.stream-qr--compact {
    padding: 6px;
    border-width: 2px;
}

/* итоги матча: компактно в левом нижнем углу, под таблицей и левее пьедестала */
.stream-qr--corner {
    top: auto;
    left: 8px;
    bottom: 8px;
}

.stream-qr--compact .stream-qr-title { font-size: 9px; margin-bottom: 4px; }
.stream-qr--compact .stream-qr-image { width: 112px; height: 112px; }
.stream-qr--compact .stream-qr-code { font-size: 10px; margin-top: 4px; }
.stream-qr--compact .stream-qr-queue { font-size: 8px; margin-top: 3px; }

/* зритель в очереди: плашка сверху по центру */
.stream-wait {
    position: absolute;
    left: 0;
    right: 0;
    top: 120px;
    align-items: center;
}

.stream-wait-place {
    font-size: 24px;
    color: rgb(255, 150, 30);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.stream-wait-note {
    font-size: 13px;
    margin-top: 10px;
    white-space: normal;
    max-width: 820px;
    -unity-text-align: middle-center;
}

/* окно «Управление стримом» */
.stream-panel {
    width: 900px;
    max-height: 94%;
    background-color: rgb(28, 32, 40);
}

.stream-panel-code {
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.stream-stepper {
    font-size: 12px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.stream-step {
    width: 44px;
    padding: 0;
    font-size: 14px;
}

.stream-step-value {
    width: 48px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.stream-toggles {
    margin-top: 6px;
}

.stream-list {
    background-color: rgba(0, 0, 0, 0.25);
    padding: 2px 6px;
}

.stream-row {
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.stream-name {
    font-size: 11px;
    overflow: hidden;
}

.touch-mode .stream-qr { top: 160px; }
.touch-mode .stream-panel { width: 96%; }
.touch-mode .stream-wait { top: 150px; }

.stream-announce-note {
    white-space: normal;
    margin: 4px;
}

.skin-hint {
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 640px;
    margin-bottom: 8px;
}
